{
  "name": "smart-hammer-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mock": "node mock/start.mjs",
    "test": "node --test test/*.test.mjs",
    "test:spa": "node --test test/spa-navigation.test.mjs",
    "test:socket": "node --test test/socket.integration.test.mjs",
    "test:bids": "node --test test/bid*.test.mjs",
    "test:closure": "node --test test/auction-lifecycle.test.mjs test/countdown.test.mjs",
    "test:ai": "node --test test/ai.integration.test.mjs",
    "test:recovery": "node --test test/state.test.mjs test/bid.integration.test.mjs test/socket.integration.test.mjs",
    "build": "vite build",
    "check:production-config": "node scripts/check-production-config.mjs",
    "build:production": "npm run check:production-config && vite build && node scripts/verify-production-build.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "axios": "^1.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}

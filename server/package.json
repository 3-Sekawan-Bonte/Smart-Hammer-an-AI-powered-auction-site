{
  "name": "smart-hammer-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "npm run db:migrate:test && jest --runInBand",
    "db:create:test": "sequelize-cli db:create --env test",
    "db:migrate:test": "sequelize-cli db:migrate --env test",
    "db:migrate:status:test": "sequelize-cli db:migrate:status --env test",
    "seed:demo": "sequelize-cli db:seed:all --env development"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "sequelize-cli": "^6.6.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0"
  }
}

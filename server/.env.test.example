# Dedicated PostgreSQL database used only by backend integration tests.
# Database name must end with _test. Do not point this at development or production.
TEST_DB_NAME=smart_hammer_test
TEST_DB_USERNAME=your_local_postgres_username
TEST_DB_PASSWORD=your_local_postgres_password
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_SSL=false

# Alternatively use a dedicated URL whose database name ends in _test.
TEST_DATABASE_URL=

PORT=3000

# Set DATABASE_URL, or configure the DB_* values below.
DATABASE_URL=
DB_NAME=smart_hammer_development
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false

# Required for login and protected endpoints. Generate a private random value.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated exact frontend origins; local Vite defaults also allow 127.0.0.1:5173 in development.
CLIENT_ORIGIN=http://localhost:5173

# Required server-side for Product Q&A and Auctioneer commentary.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Demo seeding is opt-in and intended only for local development/testing.
DEMO_SEED_ENABLED=false
DEMO_SEED_PASSWORD=password123

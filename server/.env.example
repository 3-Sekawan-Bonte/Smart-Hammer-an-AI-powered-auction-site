PORT=3000

# Set DATABASE_URL, or configure the DB_* values below.
DATABASE_URL=
DB_NAME=smart_hammer_development
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false

# Required for login and protected endpoints. Generate a private random value.
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Optional until AI features are implemented.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Example reverse proxy with separate frontend and API hostnames.
# Replace hostnames/upstream with the approved deployment values and terminate TLS at the edge.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

upstream smart_hammer_frontend { server frontend:8080; }
upstream smart_hammer_backend { server backend:3001; }

server {
  listen 443 ssl;
  server_name app.example.com;
  location / {
    proxy_pass http://smart_hammer_frontend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 443 ssl;
  server_name api.example.com;
  location /socket.io/ {
    proxy_pass http://smart_hammer_backend/socket.io/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 75s;
  }
  location / {
    proxy_pass http://smart_hammer_backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
}
